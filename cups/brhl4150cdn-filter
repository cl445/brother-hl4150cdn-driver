#!/usr/bin/env python3
"""CUPS filter for the Brother HL-4150CDN: runs `brother_xl2hb.cups_filter` for it.

Installed, the package sits next to this script in /usr/local/lib/brhl4150cdn/
(the CUPS wrapper also sets PYTHONPATH); in the repository it is in src/.
"""

import sys
from pathlib import Path

_SCRIPT_DIR = Path(__file__).resolve().parent
for _dir in (_SCRIPT_DIR, _SCRIPT_DIR.parent / "src"):
    if (_dir / "brother_xl2hb" / "__init__.py").is_file():
        sys.path.insert(0, str(_dir))
        break

from brother_xl2hb.cups_filter import main  # noqa: E402
from brother_xl2hb.models import MODELS  # noqa: E402

if __name__ == "__main__":
    main(MODELS["hl4150cdn"])
