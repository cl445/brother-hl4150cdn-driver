#!/usr/bin/env python3
"""CUPS filter for the Brother HL-4150CDN: runs `brother_xl2hb.cups_filter`.

Installed, the package sits next to this script in /usr/local/lib/brhl4150cdn/
(the CUPS wrapper also sets PYTHONPATH); in the repository it is in src/.
"""

import sys
from pathlib import Path

_SCRIPT_DIR = Path(__file__).resolve().parent
_SRC_DIR = _SCRIPT_DIR.parent / "src"
sys.path.insert(0, str(_SRC_DIR if _SRC_DIR.is_dir() else _SCRIPT_DIR))

from brother_xl2hb.cups_filter import main  # noqa: E402

if __name__ == "__main__":
    main()
